# Copiez ce fichier en .env puis complétez-le. Le fichier .env n'est jamais envoyé sur GitHub.

# Fournisseur du modèle de langage : openai (par défaut), gemini ou ollama
LLM_PROVIDER=openai

# Nom du modèle (facultatif pour openai : gpt-4o-mini par défaut ; obligatoire pour gemini et ollama)
LLM_MODEL=

# Clés d'API (laisser vide si vous préférez la saisir dans la barre latérale)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Adresse du service (facultatif ; ex : Ollama sur une autre machine)
LLM_BASE_URL=
